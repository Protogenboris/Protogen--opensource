#include "espnowcom.h"
#include <esp_now.h>
#include <esp_wifi.h>
#include <WiFi.h>
#include "faces.h"
#include "oled_menu.h"
#include <U8g2lib.h>

// External variable declarations
extern volatile bool faceUpdateRequested;
extern volatile char requestedCommand;
extern volatile bool displayUpdateNeeded;
extern const uint16_t* currentFaceBitmap;
extern const char* currentFaceName;

void onDataReceived(const uint8_t* mac, const uint8_t* data, int len) {
    if (len > 0) {
        requestedCommand = static_cast<char>(data[0]);
        faceUpdateRequested = true;
    } else {
        Serial.println("Received empty data packet.");
    }
}

void processFaceUpdate() {
    int faceIndex = -1;
    
    switch (requestedCommand) {
        case 'A': faceIndex = 0; break; // Basic face
        case 'B': faceIndex = 1; break; // Calm face
        case 'C': faceIndex = 2; break; // Energetic face
        case 'D': faceIndex = 3; break; // Huh face
        case 'E': faceIndex = 4; break; // Love face
        case 'F': faceIndex = 5; break; // Really face
        case 'G': faceIndex = 6; break; // Shy face
        default: 
            Serial.printf("Unknown command: %c\n", requestedCommand); 
            return;
    }
    
    // Use the centralized face management system
    setFace(faceIndex);
    currentFaceBitmap = getCurrentFace();
    currentFaceName = getcurrentFaceName();
    
    Serial.printf("Face changed to: %s (index %d)\n", currentFaceName, faceIndex);
    updateOLED(currentFaceBitmap, currentFaceName);
}

// Initialize ESP-NOW
void initESPNow() {
    WiFi.mode(WIFI_STA);
    if (esp_now_init() != ESP_OK) {
        Serial.println("Error initializing ESP-NOW");
        updateOLED(nullptr, "Unable to connect with ProtoPaw");
        return;
    }
    
    Serial.println("ESP-NOW initialized");
    uint8_t mac[6];
    esp_wifi_get_mac(WIFI_IF_STA, mac);
    Serial.printf("MAC Address: %02X:%02X:%02X:%02X:%02X:%02X\n",
                  mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
    updateOLED(nullptr, "ESP-NOW Ready");

    // Register the callback function for data reception
    esp_now_register_recv_cb(onDataReceived);
}
